files:
  "/etc/php.d/99_laravel.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      memory_limit = 256M
      upload_max_filesize = 10M
      post_max_size = 10M
      max_execution_time = 300
      max_input_time = 300
      date.timezone = UTC
      opcache.enable = 1
      opcache.memory_consumption = 128
      opcache.interned_strings_buffer = 8
      opcache.max_accelerated_files = 10000
      opcache.revalidate_freq = 60

option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: "false"
    CACHE_DRIVER: file
    SESSION_DRIVER: file
    QUEUE_DRIVER: database
    LOG_CHANNEL: stack
