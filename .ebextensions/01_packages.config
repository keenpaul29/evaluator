container_commands:
  00_composer_install:
    command: "composer install --no-dev --optimize-autoloader --no-interaction"
    leader_only: true
  01_run_migrations:
    command: "php -r \"\\$c=new mysqli(getenv('DB_HOST')?:'localhost',getenv('DB_USERNAME')?:'root',getenv('DB_PASSWORD')?:'');if(!\\$c->connect_error){\\$c->query('CREATE DATABASE IF NOT EXISTS `'.(getenv('DB_DATABASE')?:'evaluator').'`');\\$c->close();echo 'DB ready\n';}\" && php artisan migrate --force"
    leader_only: true
  02_key_generate:
    command: "php artisan key:generate --force"
    leader_only: true
  03_cache_config:
    command: "php artisan config:cache"
    leader_only: true
  04_cache_routes:
    command: "php artisan route:cache"
    leader_only: true
  05_cache_views:
    command: "php artisan view:cache"
    leader_only: true
  06_npm_install:
    command: "npm ci --ignore-scripts"
    leader_only: true
  07_npm_build:
    command: "npm run build"
    leader_only: true
  08_storage_link:
    command: "php artisan storage:link --force"
    leader_only: true
  09_queue_restart:
    command: "php artisan queue:restart"
    leader_only: true

option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: "false"
    DB_CONNECTION: mysql
    CACHE_DRIVER: file
    SESSION_DRIVER: file
    QUEUE_CONNECTION: database
    LOG_CHANNEL: stack
    COMPOSER_HOME: /root

files:
  "/etc/php.d/99_laravel.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      memory_limit = 256M
      upload_max_filesize = 10M
      post_max_size = 10M
      max_execution_time = 300
      max_input_time = 300
      date.timezone = UTC
