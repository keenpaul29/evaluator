container_commands:
  00_composer_install:
    command: "composer install --no-dev --optimize-autoloader --no-interaction"
    leader_only: true
  00_test_db:
    command: "php -r \"\\$c=new mysqli(getenv('DB_HOST')?:'127.0.0.1',getenv('DB_USERNAME')?:'root',getenv('DB_PASSWORD')?:'',getenv('DB_DATABASE')?:'');if(\\$c->connect_error){echo 'DB_FAIL: '.\\$c->connect_error;exit(1);}echo 'DB_OK';\\$c->close();\""
    leader_only: true
  01_run_migrations:
    command: "php artisan migrate --force"
    leader_only: true
  02_key_generate:
    command: "php artisan key:generate --force"
    leader_only: true
  03_cache_config:
    command: "php artisan config:cache"
    leader_only: true
  04_cache_routes:
    command: "php artisan route:cache"
    leader_only: true
  05_cache_views:
    command: "php artisan view:cache"
    leader_only: true
  06_npm_install:
    command: "npm ci --ignore-scripts"
    leader_only: true
  07_npm_build:
    command: "npm run build"
    leader_only: true
  08_storage_link:
    command: "php artisan storage:link --force"
    leader_only: true
  09_queue_restart:
    command: "php artisan queue:restart"
    leader_only: true

option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: "false"
    DB_CONNECTION: mysql
    DB_HOST: evaluator-db.cqrw4e2m4ilq.us-east-1.rds.amazonaws.com
    DB_PORT: "3306"
    DB_DATABASE: evaluator
    DB_USERNAME: admin
    DB_PASSWORD: mGlrJCUHLv
    CACHE_DRIVER: file
    SESSION_DRIVER: file
    QUEUE_CONNECTION: database
    LOG_CHANNEL: stack
    COMPOSER_HOME: /root
    GITHUB_API_TOKEN: ""
    GEMINI_API_KEY: ""
    OPENAI_API_KEY: ""
    AI_PROVIDER: gemini

files:
  "/etc/php.d/99_laravel.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      memory_limit = 256M
      upload_max_filesize = 10M
      post_max_size = 10M
      max_execution_time = 300
      max_input_time = 300
      date.timezone = UTC

  "/var/app/staging/.env":
    mode: "000644"
    owner: webapp
    group: webapp
    content: |
      APP_NAME="ColoredCow Evaluator"
      APP_ENV=production
      APP_KEY=
      APP_DEBUG=false
      APP_URL=https://evaluator-env.eba-gjaax96g.us-east-1.elasticbeanstalk.com
      APP_LOCALE=en
      APP_FALLBACK_LOCALE=en
      APP_FAKER_LOCALE=en_US
      APP_MAINTENANCE_DRIVER=file
      BCRYPT_ROUNDS=12
      LOG_CHANNEL=stack
      LOG_STACK=single
      LOG_DEPRECATIONS_CHANNEL=null
      LOG_LEVEL=debug
      DB_CONNECTION=mysql
      DB_HOST=evaluator-db.cqrw4e2m4ilq.us-east-1.rds.amazonaws.com
      DB_PORT=3306
      DB_DATABASE=evaluator
      DB_USERNAME=admin
      DB_PASSWORD=mGlrJCUHLv
      SESSION_DRIVER=file
      SESSION_LIFETIME=120
      SESSION_ENCRYPT=false
      SESSION_PATH=/
      SESSION_DOMAIN=null
      BROADCAST_CONNECTION=log
      FILESYSTEM_DISK=local
      QUEUE_CONNECTION=database
      CACHE_STORE=file
      GITHUB_API_TOKEN=
      AI_PROVIDER=gemini
      OPENAI_API_KEY=
      OPENAI_MODEL=gpt-4o-mini
      GEMINI_API_KEY=
      GEMINI_MODEL=gemini-1.5-flash
