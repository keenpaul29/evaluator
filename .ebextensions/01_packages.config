container_commands:
  00_composer_install:
    command: "composer install --no-dev --optimize-autoloader --no-interaction"
    leader_only: true
  01_create_database:
    command: "php artisan db:create-if-not-exists"
    leader_only: true
  02_key_generate:
    command: "php artisan key:generate --force"
    leader_only: true
  03_migrate:
    command: "php artisan migrate --force"
    leader_only: true
  04_cache_config:
    command: "php artisan config:cache"
    leader_only: true
  05_cache_routes:
    command: "php artisan route:cache"
    leader_only: true
  06_cache_views:
    command: "php artisan view:cache"
    leader_only: true
  07_npm_install:
    command: "npm ci --ignore-scripts"
    leader_only: true
  08_npm_build:
    command: "npm run build"
    leader_only: true
  09_storage_link:
    command: "php artisan storage:link --force"
    leader_only: true
  10_queue_restart:
    command: "php artisan queue:restart"
    leader_only: true

option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: "false"
    DB_CONNECTION: mysql
    CACHE_DRIVER: file
    SESSION_DRIVER: file
    QUEUE_CONNECTION: database
    LOG_CHANNEL: stack
    COMPOSER_HOME: /root

files:
  "/etc/php.d/99_laravel.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      memory_limit = 256M
      upload_max_filesize = 10M
      post_max_size = 10M
      max_execution_time = 300
      max_input_time = 300
      date.timezone = UTC
