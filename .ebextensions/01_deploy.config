option_settings:
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: "false"
    APP_URL: "https://coloredcow-eval.duckdns.org"
    CACHE_STORE: file
    SESSION_DRIVER: file
    QUEUE_CONNECTION: database
    LOG_CHANNEL: stack
    AI_PROVIDER: gemini

container_commands:
  01_set_permissions:
    command: "chmod -R 775 storage bootstrap/cache && chown -R webapp:webapp storage bootstrap/cache"

  02_run_migrations:
    command: "php artisan migrate --force"
    leader_only: true

  03_cache_config:
    command: "php artisan config:cache"
    leader_only: true

  04_cache_routes:
    command: "php artisan route:cache || true"
    leader_only: true

  05_cache_views:
    command: "php artisan view:cache"
    leader_only: true

  06_storage_link:
    command: "php artisan storage:link --force || true"
    leader_only: true

  07_queue_restart:
    command: "php artisan queue:restart || true"
    leader_only: true

files:
  "/etc/php.d/99_laravel.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      memory_limit = 256M
      upload_max_filesize = 10M
      post_max_size = 10M
      max_execution_time = 300
      max_input_time = 300
      date.timezone = UTC